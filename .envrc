# Lab environment. No secrets here, only paths to them, so this file is committed.
export KUBECONFIG="$PWD/kubeconfig"
export TALOSCONFIG="$PWD/talosconfig"
export SOPS_AGE_KEY_FILE="$HOME/.lab/age.key"
export AWS_PROFILE=cloudru

# Personal and secret settings (Proxmox token from the keyring) are in a file outside Git
source_env_if_exists .envrc.local
export TF_INPUT=0 # не спрашивать переменные интерактивно: без токена сразу ошибка
